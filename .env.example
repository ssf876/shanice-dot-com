# No environment variables are required to build or run the site.
# Keep any future local configuration in .env, which is gitignored.
# Never put secrets in browser-exposed VITE_* variables.

# Server-only contact delivery on Vercel. Never prefix these with VITE_.
# Resend sending API key (configure privately in Vercel).
RESEND_API_KEY=
# Sender address on a domain verified with Resend.
CONTACT_FROM=
# Private destination inbox; never placed in frontend content.
CONTACT_TO=
