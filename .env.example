# Firebase web-app configuration
# Values come from the Firebase console: Project settings > General > Your apps > Web app.
#
# Copy this file to .env and fill in real values. .env is gitignored and must never
# be committed. Every variable is optional: with none set, the site builds and
# renders normally (Firebase stays uninitialized - getFirebaseApp() returns null).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
